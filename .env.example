# ==============================================================================
# AI-Driven Software Quality Engineering Platform
# Environment configuration template.
# Copy this file to .env and configure local values as needed.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_PORT=3000
LOG_LEVEL=info

# PostgreSQL Database Configuration
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]
DATABASE_URL=postgresql://username:password@127.0.0.1:5432/ai_quality_platform

# Future Phase Placeholders (Do not populate with production credentials)
# JIRA_BASE_URL=
# JIRA_API_TOKEN=
# AI_GATEWAY_API_KEY=
