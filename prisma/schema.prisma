// ------------------------------------------------------------------------------
// Models
// ------------------------------------------------------------------------------

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(120)
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  userId       String?   @map("user_id") @db.Uuid
  lastOpenedAt DateTime? @map("last_opened_at") @db.Timestamptz(6)
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  isFavorite   Boolean   @default(false) @map("is_favorite")

  settings                          ProjectSettings?
  targetApplication                 TargetApplication?
  environments                      ProjectEnvironment[]
  source                            ProjectSource?
  requirementSources                RequirementSource[]
  requirements                      Requirement[]
  requirementDocuments              RequirementDocument[]
  requirementDocumentExtractions    RequirementDocumentExtraction[]
  requirementCandidates             RequirementCandidate[]
  requirementProvenances            RequirementProvenance[]
  requirementRepresentations        RequirementRepresentation[]
  requirementMetadata               RequirementMetadata[]
  requirementQualityAnalyses        RequirementQualityAnalysis[]
  requirementQualityFindings        RequirementQualityFinding[]
  requirementRelationships          RequirementRelationship[]
  requirementRepositoryEvidence     RequirementRepositoryEvidence[]
  requirementVersions               RequirementVersion[]
  requirementChangeImpacts          RequirementChangeImpact[]
  requirementSequence               ProjectRequirementSequence?
  vectorEmbeddings                  VectorEmbedding[]
  requirementAiAnalyses             RequirementAiAnalysis[]
  requirementTestDesigns            RequirementTestDesign[]
  requirementScenarioGenerations    RequirementScenarioGeneration[]
  requirementScenarioCandidates     RequirementScenarioCandidate[]
  testCaseSequence                  ProjectTestCaseSequence?
  testCases                         TestCase[]
  testCaseValidations               TestCaseValidation[]
  testTraces                        RequirementTestTrace[]
  testCaseVersions                  TestCaseVersion[]
  testCaseReviewEvents              TestCaseReviewEvent[]
  executableTestPlans               ExecutableTestPlan[]
  testRuns                          TestRun[]
  testCaseExecutions                TestCaseExecution[]
  stepExecutionRecords              StepExecutionRecord[]
  assertionExecutionRecords         AssertionExecutionRecord[]
  testExecutionStateTransitions     TestExecutionStateTransition[]
  evidenceBundles                   ExecutionEvidenceBundle[]
  evidenceArtifacts                 ExecutionEvidenceArtifact[]
  authProfiles                      AuthenticationProfile[]
  locatorHealingAttempts            LocatorHealingAttempt[]
  locatorHealingSuggestions         LocatorHealingSuggestion[]
  executionResourceLocks            ExecutionResourceLock[]
  failureCases                      FailureCase[]
  failureAnalysisRuns               FailureAnalysisRun[]
  failureEvidenceReferences         FailureEvidenceReference[]
  failureReproductionAttempts       FailureReproductionAttempt[]
  failureClassifications            FailureClassification[]
  classificationDecisionIntegrities ClassificationDecisionIntegrity[]
  flakinessAnalyses                 FlakinessAnalysis[]
  domainSeparations                 FailureDomainSeparation[]
  technicalLocalizations            FailureTechnicalLocalization[]
  failureAiAssessments              FailureAiAssessment[]
  failureRootCauseAnalyses          FailureRootCauseAnalysis[]
  failureImpactAssessments          FailureImpactAssessment[]
  defectClusters                    DefectCluster[]
  defectClusterMemberships          DefectClusterMembership[]
  defectClusterHistories            DefectClusterHistory[]
  confidenceAssessments             ConfidenceAssessment[]
  evidenceAttributions              EvidenceAttribution[]
  structuredBugReports              StructuredBugReport[]
  jiraConnections                   JiraConnection[]
  jiraConnectionAudits              JiraConnectionAudit[]
  jiraProjectConfig                 JiraProjectConfig?
  jiraExternalIssues                JiraExternalIssue[]
  jiraEvidenceAttachments           JiraEvidenceAttachment[]
  jiraIssueLinks                    JiraIssueLink[]
  projectEngineers                  ProjectEngineer[]
  defectOwnerships                  DefectOwnership[]
  defectOwnershipHistories          DefectOwnershipHistory[]
  projectEmailConfig                ProjectEmailConfig?
  emailNotifications                EmailNotification[]
  notificationAudits                NotificationAudit[]
  bugWorkflowStates                 BugWorkflowState[]
  workflowStatusMappings            WorkflowStatusMapping[]
  workflowSyncEvents                WorkflowSyncEvent[]
  defectReverifications             DefectReverification[]
  reverificationAuditEvents         ReverificationAuditEvent[]
  defectVerificationAttempts        DefectVerificationAttempt[]
  quickFixEligibilityAssessments    QuickFixEligibilityAssessment[]
  defectLocalizations               RepositoryDefectLocalization[]
  defectPatchProposals              DefectPatchProposal[]
  defectPatchSandboxes              DefectPatchSandbox[]
  defectPatchValidations            DefectPatchValidation[]
  defectPatchApprovals              DefectPatchApproval[]
  defectPatchRollbacks              DefectPatchRollback[]
  changeSnapshots                   ChangeSnapshot[]
  retestPlans                       RetestPlan[]
  postFixSyncRecords                PostFixSyncRecord[]
  postFixSyncAudits                 PostFixSyncAudit[]
  repairSessions                    RepairSession[]
  repairAuditEvents                 RepairAuditEvent[]
  finalQaReports                    FinalQaReport[]
  qaReportAuditEvents               QaReportAuditEvent[]
  user                              User?                             @relation(fields: [userId], references: [id], onDelete: SetNull)
  websiteTargets                    WebsiteTarget[]
  repositoryConnections             RepositoryConnection[]
  aiProviderConfigs                 AiProviderConfig[]
  aiModelSelections                 AiModelSelection[]
  aiPrivacySettings                 AiPrivacySettings?
  aiFallbackSettings                AiFallbackSettings?
  aiGenerationRequests              AiGenerationRequest[]
  agentSessions                     AgentSession[]
  agentTasks                        AgentTask[]
  agentThreads                      AgentThread[]
  agentThreadTasks                  AgentThreadTask[]
  changeReviews                     AgentGitChangeReview[]
  terminalExecutions                AgentTerminalExecution[]
  plans                             AgentPlan[]
  approvalRequests                  ApprovalRequest[]
  fileDiffReviews                   FileDiffReview[]
  taskControlAuditLogs              AgentTaskControlAuditLog[]
  taskCheckpoints                   AgentTaskCheckpoint[]
  workflowReports                   AgentAutonomousWorkflowReport[]

  @@index([status])
  @@index([userId])
  @@index([lastOpenedAt])
  @@index([deletedAt])
  @@index([userId, status])
  @@map("projects")
}

model ProjectSettings {
  projectId String   @id @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_settings")
}

model TargetApplication {
  id                   String   @id @default(uuid()) @db.Uuid
  projectId            String   @unique @map("project_id") @db.Uuid
  name                 String   @db.VarChar(120)
  description          String?  @db.VarChar(1000)
  defaultEnvironmentId String?  @map("default_environment_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environments        ProjectEnvironment[]
  executableTestPlans ExecutableTestPlan[]
  testRuns            TestRun[]

  @@map("target_applications")
}

model ProjectEnvironment {
  id                     String                 @id @default(uuid()) @db.Uuid
  projectId              String                 @map("project_id") @db.Uuid
  targetApplicationId    String?                @map("target_application_id") @db.Uuid
  name                   String                 @db.VarChar(80)
  type                   EnvironmentType        @default(DEVELOPMENT)
  baseUrl                String?                @map("base_url") @db.VarChar(2048)
  apiUrl                 String?                @map("api_url") @db.VarChar(2048)
  isDefault              Boolean                @default(false) @map("is_default")
  isEnabled              Boolean                @default(true) @map("is_enabled")
  isProduction           Boolean                @default(false) @map("is_production")
  productionSafetyPolicy ProductionSafetyPolicy @default(PROHIBITED) @map("production_safety_policy")
  browserEngine          String                 @default("chromium") @map("browser_engine") @db.VarChar(32)
  headless               Boolean                @default(true)
  viewportWidth          Int                    @default(1280) @map("viewport_width")
  viewportHeight         Int                    @default(720) @map("viewport_height")
  locale                 String?                @db.VarChar(32)
  timezoneId             String?                @map("timezone_id") @db.VarChar(64)
  colorScheme            String                 @default("light") @map("color_scheme") @db.VarChar(20)
  ignoreHttpsErrors      Boolean                @default(false) @map("ignore_https_errors")
  permissions            String[]               @default([])
  extraHeaders           Json?                  @map("extra_headers")
  variables              Json?                  @map("variables")
  secretReferences       Json?                  @map("secret_references")
  notes                  String?                @db.VarChar(2000)
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  project                     Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targetApplication           TargetApplication?           @relation(fields: [targetApplicationId], references: [id], onDelete: SetNull)
  executableTestPlans         ExecutableTestPlan[]
  testRuns                    TestRun[]
  testCaseExecutions          TestCaseExecution[]
  authProfiles                AuthenticationProfile[]
  failureCases                FailureCase[]
  failureReproductionAttempts FailureReproductionAttempt[]
  defectReverifications       DefectReverification[]
  defectVerificationAttempts  DefectVerificationAttempt[]
  finalQaReports              FinalQaReport[]
  websiteTargets              WebsiteTarget[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([projectId, type])
  @@index([targetApplicationId])
  @@map("project_environments")
}

model ProjectSource {
  id                       String            @id @default(uuid()) @db.Uuid
  projectId                String            @unique @map("project_id") @db.Uuid
  kind                     ProjectSourceKind @default(LOCAL_DIRECTORY)
  displayName              String            @map("display_name") @db.VarChar(255)
  rootPath                 String            @map("root_path") @db.VarChar(4096)
  identityFingerprint      String?           @map("identity_fingerprint") @db.VarChar(64)
  activeBaselineSnapshotId String?           @map("active_baseline_snapshot_id") @db.Uuid
  filesystemCreatedAt      DateTime?         @map("filesystem_created_at")
  filesystemModifiedAt     DateTime?         @map("filesystem_modified_at")
  metadataRefreshedAt      DateTime?         @map("metadata_refreshed_at")
  lastValidatedAt          DateTime?         @map("last_validated_at")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")

  project                       Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  gitMetadata                   ProjectGitMetadata?
  indexRuns                     RepositoryIndexRun[]
  repositoryFiles               RepositoryFile[]
  architectureAnalysis          RepositoryArchitectureAnalysis?
  runConfigurations             ProjectRunConfiguration[]
  snapshots                     RepositorySnapshot[]
  requirementRepositoryEvidence RequirementRepositoryEvidence[]
  quickFixAssessments           QuickFixEligibilityAssessment[]
  defectLocalizations           RepositoryDefectLocalization[]
  defectPatchProposals          DefectPatchProposal[]
  defectPatchSandboxes          DefectPatchSandbox[]
  defectPatchValidations        DefectPatchValidation[]
  defectPatchApprovals          DefectPatchApproval[]
  defectPatchRollbacks          DefectPatchRollback[]

  @@map("project_sources")
}

model ProjectGitMetadata {
  id                         String            @id @default(uuid()) @db.Uuid
  sourceId                   String            @unique @map("source_id") @db.Uuid
  isGitRepository            Boolean           @map("is_git_repository")
  repositoryRoot             String?           @map("repository_root") @db.VarChar(4096)
  sourceRelationToRepository GitSourceRelation @default(UNKNOWN) @map("source_relation_to_repository")
  currentBranch              String?           @map("current_branch") @db.VarChar(255)
  headCommit                 String?           @map("head_commit") @db.VarChar(64)
  isDetachedHead             Boolean           @default(false) @map("is_detached_head")
  lastCheckedAt              DateTime          @default(now()) @map("last_checked_at")
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")

  source ProjectSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("project_git_metadata")
}

model RepositoryIndexRun {
  id                       String         @id @default(uuid()) @db.Uuid
  sourceId                 String         @map("source_id") @db.Uuid
