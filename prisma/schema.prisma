// ------------------------------------------------------------------------------
// Models
// ------------------------------------------------------------------------------

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(120)
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  settings                       ProjectSettings?
  environments                   ProjectEnvironment[]
  source                         ProjectSource?
  requirementSources             RequirementSource[]
  requirements                   Requirement[]
  requirementDocuments           RequirementDocument[]
  requirementDocumentExtractions RequirementDocumentExtraction[]
  requirementCandidates          RequirementCandidate[]
  requirementProvenances         RequirementProvenance[]
  requirementRepresentations     RequirementRepresentation[]
  requirementMetadata            RequirementMetadata[]
  requirementQualityAnalyses     RequirementQualityAnalysis[]
  requirementQualityFindings     RequirementQualityFinding[]
  requirementRelationships       RequirementRelationship[]
  requirementRepositoryEvidence  RequirementRepositoryEvidence[]
  requirementVersions            RequirementVersion[]
  requirementChangeImpacts       RequirementChangeImpact[]
  requirementSequence            ProjectRequirementSequence?
  vectorEmbeddings               VectorEmbedding[]
  requirementAiAnalyses          RequirementAiAnalysis[]
  requirementTestDesigns         RequirementTestDesign[]
  requirementScenarioGenerations RequirementScenarioGeneration[]
  requirementScenarioCandidates  RequirementScenarioCandidate[]
  testCaseSequence               ProjectTestCaseSequence?
  testCases                      TestCase[]
  testCaseValidations            TestCaseValidation[]
  testTraces                     RequirementTestTrace[]
  testCaseVersions               TestCaseVersion[]
  testCaseReviewEvents           TestCaseReviewEvent[]

  @@index([status])
  @@map("projects")
}

model ProjectSettings {
  projectId String   @id @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_settings")
}

model ProjectEnvironment {
  id        String          @id @default(uuid()) @db.Uuid
  projectId String          @map("project_id") @db.Uuid
  name      String          @db.VarChar(80)
  type      EnvironmentType @default(DEVELOPMENT)
  baseUrl   String?         @map("base_url") @db.VarChar(2048)
  isDefault Boolean         @default(false) @map("is_default")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
  @@index([projectId, type])
  @@map("project_environments")
}

model ProjectSource {
  id                       String            @id @default(uuid()) @db.Uuid
  projectId                String            @unique @map("project_id") @db.Uuid
  kind                     ProjectSourceKind @default(LOCAL_DIRECTORY)
  displayName              String            @map("display_name") @db.VarChar(255)
  rootPath                 String            @map("root_path") @db.VarChar(4096)
  identityFingerprint      String?           @map("identity_fingerprint") @db.VarChar(64)
  activeBaselineSnapshotId String?           @map("active_baseline_snapshot_id") @db.Uuid
  filesystemCreatedAt      DateTime?         @map("filesystem_created_at")
  filesystemModifiedAt     DateTime?         @map("filesystem_modified_at")
  metadataRefreshedAt      DateTime?         @map("metadata_refreshed_at")
  lastValidatedAt          DateTime?         @map("last_validated_at")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")

  project                       Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  gitMetadata                   ProjectGitMetadata?
  indexRuns                     RepositoryIndexRun[]
  repositoryFiles               RepositoryFile[]
  architectureAnalysis          RepositoryArchitectureAnalysis?
  runConfigurations             ProjectRunConfiguration[]
  snapshots                     RepositorySnapshot[]
  requirementRepositoryEvidence RequirementRepositoryEvidence[]

  @@map("project_sources")
}

model ProjectGitMetadata {
  id                         String            @id @default(uuid()) @db.Uuid
  sourceId                   String            @unique @map("source_id") @db.Uuid
  isGitRepository            Boolean           @map("is_git_repository")
  repositoryRoot             String?           @map("repository_root") @db.VarChar(4096)
  sourceRelationToRepository GitSourceRelation @default(UNKNOWN) @map("source_relation_to_repository")
  currentBranch              String?           @map("current_branch") @db.VarChar(255)
  headCommit                 String?           @map("head_commit") @db.VarChar(64)
  isDetachedHead             Boolean           @default(false) @map("is_detached_head")
  lastCheckedAt              DateTime          @default(now()) @map("last_checked_at")
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")

  source ProjectSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("project_git_metadata")
}

model RepositoryIndexRun {
  id                       String         @id @default(uuid()) @db.Uuid
  sourceId                 String         @map("source_id") @db.Uuid
  status                   IndexRunStatus @default(RUNNING)
  schemaVersion            Int            @default(1) @map("schema_version")
  parserVersion            Int            @default(1) @map("parser_version")
  filesEligible            Int            @default(0) @map("files_eligible")
  filesIndexed             Int            @default(0) @map("files_indexed")
  filesSkipped             Int            @default(0) @map("files_skipped")
  filesFailed              Int            @default(0) @map("files_failed")
  symbolsIndexed           Int            @default(0) @map("symbols_indexed")
  importsIndexed           Int            @default(0) @map("imports_indexed")
  exportsIndexed           Int            @default(0) @map("exports_indexed")
  unsupportedLanguageFiles Int            @default(0) @map("unsupported_language_files")
  durationMs               Int?           @map("duration_ms")
  truncated                Boolean        @default(false)
  warnings                 String[]       @default([])
  startedAt                DateTime       @default(now()) @map("started_at")
  completedAt              DateTime?      @map("completed_at")

  source               ProjectSource                    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  architectureAnalyses RepositoryArchitectureAnalysis[]
  snapshots            RepositorySnapshot[]

  @@index([sourceId])
  @@index([sourceId, status])
  @@map("repository_index_runs")
}

model RepositoryFile {
  id             String      @id @default(uuid()) @db.Uuid
  sourceId       String      @map("source_id") @db.Uuid
  relativePath   String      @map("relative_path") @db.VarChar(1024)
  name           String      @db.VarChar(255)
  extension      String?     @db.VarChar(64)
  language       String?     @db.VarChar(64)
  classification String      @db.VarChar(64)
  sizeBytes      Int         @map("size_bytes")
  contentHash    String?     @map("content_hash") @db.VarChar(64)
  indexStatus    IndexStatus @default(INDEXED) @map("index_status")
  indexedAt      DateTime    @default(now()) @map("indexed_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  source                        ProjectSource                   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  symbols                       RepositorySymbol[]
  imports                       RepositoryImport[]
  requirementRepositoryEvidence RequirementRepositoryEvidence[]

  @@unique([sourceId, relativePath])
  @@index([sourceId])
  @@index([sourceId, language])
  @@index([sourceId, classification])
  @@index([sourceId, indexStatus])
  @@map("repository_files")
}

model RepositorySymbol {
  id               String     @id @default(uuid()) @db.Uuid
  repositoryFileId String     @map("repository_file_id") @db.Uuid
  name             String     @db.VarChar(255)
  kind             SymbolKind @default(UNKNOWN)
  startLine        Int        @map("start_line")
  endLine          Int        @map("end_line")
  isExported       Boolean    @default(false) @map("is_exported")
  createdAt        DateTime   @default(now()) @map("created_at")

  repositoryFile                RepositoryFile                  @relation(fields: [repositoryFileId], references: [id], onDelete: Cascade)
  requirementRepositoryEvidence RequirementRepositoryEvidence[]

  @@index([repositoryFileId])
  @@index([name])
  @@index([repositoryFileId, kind])
  @@map("repository_symbols")
}

model RepositoryImport {
  id                   String     @id @default(uuid()) @db.Uuid
  repositoryFileId     String     @map("repository_file_id") @db.Uuid
  specifier            String     @db.VarChar(1024)
  importKind           ImportKind @default(LOCAL) @map("import_kind")
  resolvedRelativePath String?    @map("resolved_relative_path") @db.VarChar(1024)
  isExternal           Boolean    @default(false) @map("is_external")
  lineNumber           Int        @map("line_number")
  createdAt            DateTime   @default(now()) @map("created_at")

  repositoryFile RepositoryFile @relation(fields: [repositoryFileId], references: [id], onDelete: Cascade)

  @@index([repositoryFileId])
  @@index([repositoryFileId, isExternal])
  @@index([resolvedRelativePath])
  @@map("repository_imports")
}

model RepositoryArchitectureAnalysis {
  id                   String                     @id @default(uuid()) @db.Uuid
  sourceId             String                     @unique @map("source_id") @db.Uuid
  indexRunId           String?                    @map("index_run_id") @db.Uuid
  status               ArchitectureAnalysisStatus @default(CURRENT)
  architectureVersion  Int                        @default(1) @map("architecture_version")
  primaryKind          ApplicationKind            @default(UNKNOWN) @map("primary_kind")
  confidence           ArchitectureConfidence     @default(LOW)
  applicationKindsJson Json                       @map("application_kinds_json")
  applicationUnitsJson Json                       @map("application_units_json")
  entryCandidatesJson  Json                       @map("entry_candidates_json")
  structuralAreasJson  Json                       @map("structural_areas_json")
  signalsJson          Json                       @map("signals_json")
  moduleHubsJson       Json                       @map("module_hubs_json")
  warnings             String[]                   @default([])
  analyzedAt           DateTime                   @default(now()) @map("analyzed_at")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  source   ProjectSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  indexRun RepositoryIndexRun? @relation(fields: [indexRunId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([indexRunId])
  @@map("repository_architecture_analyses")
}

model ProjectRunConfiguration {
  id                       String                 @id @default(uuid()) @db.Uuid
  sourceId                 String                 @map("source_id") @db.Uuid
  applicationUnitRoot      String                 @default(".") @map("application_unit_root") @db.VarChar(1024)
  runtime                  String?                @db.VarChar(64)
  packageManager           String?                @map("package_manager") @db.VarChar(64)
  startupKind              StartupKind            @default(UNKNOWN) @map("startup_kind")
  executable               String                 @db.VarChar(255)
  args                     String[]               @default([])
  workingDirectory         String                 @default(".") @map("working_directory") @db.VarChar(1024)
  targetUrl                String?                @map("target_url") @db.VarChar(2048)
  environmentVariableNames String[]               @default([]) @map("environment_variable_names")
  confidence               ArchitectureConfidence @default(LOW)
  safety                   RunConfigSafety        @default(SAFE_STRUCTURE)
  source                   RunConfigSource        @default(DETECTED)
  status                   RunConfigStatus        @default(CONFIGURED)
  isSelected               Boolean                @default(false) @map("is_selected")
  evidenceJson             Json?                  @map("evidence_json")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")

  projectSource ProjectSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([sourceId, isSelected])
  @@map("project_run_configurations")
}

model RepositorySnapshot {
  id              String         @id @default(uuid()) @db.Uuid
  sourceId        String         @map("source_id") @db.Uuid
  indexRunId      String?        @map("index_run_id") @db.Uuid
  label           String?        @db.VarChar(255)
  kind            SnapshotKind   @default(MANUAL_BASELINE)
  status          SnapshotStatus @default(COMPLETE)
  snapshotVersion Int            @default(1) @map("snapshot_version")
  fingerprint     String         @db.VarChar(64)
  fileCount       Int            @default(0) @map("file_count")
  sourceFileCount Int            @default(0) @map("source_file_count")
  testFileCount   Int            @default(0) @map("test_file_count")
  gitHeadCommit   String?        @map("git_head_commit") @db.VarChar(64)
  gitBranch       String?        @map("git_branch") @db.VarChar(255)
  createdAt       DateTime       @default(now()) @map("created_at")

  source                        ProjectSource                   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  indexRun                      RepositoryIndexRun?             @relation(fields: [indexRunId], references: [id], onDelete: SetNull)
  files                         RepositorySnapshotFile[]
  requirementRepositoryEvidence RequirementRepositoryEvidence[]

  @@index([sourceId])
  @@index([sourceId, createdAt])
  @@map("repository_snapshots")
}

model RepositorySnapshotFile {
  id             String   @id @default(uuid()) @db.Uuid
  snapshotId     String   @map("snapshot_id") @db.Uuid
  relativePath   String   @map("relative_path") @db.VarChar(1024)
  contentHash    String?  @map("content_hash") @db.VarChar(64)
  language       String?  @db.VarChar(64)
  classification String   @db.VarChar(64)
  sizeBytes      Int      @map("size_bytes")
  createdAt      DateTime @default(now()) @map("created_at")

  snapshot RepositorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, relativePath])
  @@index([snapshotId])
  @@index([snapshotId, contentHash])
  @@map("repository_snapshot_files")
}

model RequirementSource {
  id          String                  @id @default(uuid()) @db.Uuid
  projectId   String                  @map("project_id") @db.Uuid
  name        String                  @db.VarChar(255)
  sourceType  RequirementSourceType   @default(MANUAL) @map("source_type")
  status      RequirementSourceStatus @default(ACTIVE)
  description String?                 @db.Text
  metadata    Json?                   @map("metadata")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  project                Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirements           Requirement[]
  document               RequirementDocument?
  requirementProvenances RequirementProvenance[]

  @@index([projectId])
  @@index([projectId, status])
  @@map("requirement_sources")
}

model Requirement {
  id                  String              @id @default(uuid()) @db.Uuid
  projectId           String              @map("project_id") @db.Uuid
  requirementSourceId String?             @map("requirement_source_id") @db.Uuid
  requirementKey      String              @map("requirement_key") @db.VarChar(64)
  title               String              @db.VarChar(255)
  originalText        String              @map("original_text") @db.Text
  type                RequirementType     @default(UNKNOWN)
