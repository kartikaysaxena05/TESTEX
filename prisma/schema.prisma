// Prisma Schema — Core Project, Source, Git, Index, Architecture, Run Config, Snapshot & Requirement Models (PostgreSQL)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

