  repositoryIdentifier String                     @map("repository_identifier") @db.VarChar(255)
  repositoryName       String                     @map("repository_name") @db.VarChar(255)
  owner                String                     @db.VarChar(255)
  repositoryUrl        String                     @map("repository_url") @db.VarChar(2048)
  displayName          String                     @map("display_name") @db.VarChar(255)
  visibility           RepositoryVisibility       @default(PUBLIC)
  defaultBranch        String                     @default("main") @map("default_branch") @db.VarChar(255)
  selectedBranch       String                     @default("main") @map("selected_branch") @db.VarChar(255)
  selectedRevision     String?                    @map("selected_revision") @db.VarChar(64)
  importedRevision     String?                    @map("imported_revision") @db.VarChar(64)
  connectionStatus     RepositoryConnectionStatus @default(CONFIGURED) @map("connection_status")
  importStatus         RepositoryImportStatus     @default(NOT_IMPORTED) @map("import_status")
  isActive             Boolean                    @default(false) @map("is_active")
  encryptedCredentials String?                    @map("encrypted_credentials") @db.Text
  localPath            String?                    @map("local_path") @db.VarChar(4096)
  lastVerifiedAt       DateTime?                  @map("last_verified_at")
  lastImportedAt       DateTime?                  @map("last_imported_at")
  lastFailureReason    String?                    @map("last_failure_reason") @db.VarChar(1000)
  fileCount            Int                        @default(0) @map("file_count")
  totalSizeBytes       BigInt                     @default(0) @map("total_size_bytes")
  deletedAt            DateTime?                  @map("deleted_at")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  project Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imports RepositoryImportRecord[]

  @@index([projectId])
  @@index([projectId, isActive])
  @@index([projectId, provider, repositoryIdentifier])
  @@index([deletedAt])
  @@map("repository_connections")
}

model RepositoryImportRecord {
  id                     String                 @id @default(uuid()) @db.Uuid
  repositoryConnectionId String                 @map("repository_connection_id") @db.Uuid
  projectId              String                 @map("project_id") @db.Uuid
