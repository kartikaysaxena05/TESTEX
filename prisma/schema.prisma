  userId                  String                @map("user_id") @db.Uuid
  stepId                  String?               @map("step_id") @db.Uuid
  sequenceNumber          Int                   @map("sequence_number")
  taskStatus              AgentThreadTaskStatus @map("task_status")
  serializedRecoveryState String                @map("serialized_recovery_state") @db.Text
  activeToolCall          String?               @map("active_tool_call") @db.VarChar(128)
  completedStepCount      Int                   @default(0) @map("completed_step_count")
  pendingStepCount        Int                   @default(0) @map("pending_step_count")
  retryCount              Int                   @default(0) @map("retry_count")
  isRecoverable           Boolean               @default(true) @map("is_recoverable")
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  thread  AgentThread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  task    AgentThreadTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  step    AgentExecutionStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@unique([taskId, sequenceNumber])
  @@index([projectId])
  @@index([threadId])
  @@index([taskId])
  @@index([userId])
  @@index([taskId, sequenceNumber])
  @@index([taskId, createdAt])
  @@map("agent_task_checkpoints")
}

// ==============================================================================
// V10 Phase 159: Full Autonomous Testing + Fix Workflow
// ==============================================================================

enum AutonomousWorkflowStatus {
  PLANNING
  CONTEXT_COLLECTED
  TESTS_EXECUTED
  FAILURES_ANALYZED
  PATCH_PROPOSED
  WAITING_FOR_APPROVAL
  PATCH_APPROVED
  PATCH_REJECTED
  PATCH_APPLIED
  REVERIFIED
  RETESTED
  COMPLETED
  FAILED
  CANCELLED
}

enum AutonomousWorkflowFinalStatus {
  FIXED_AND_VERIFIED
  NON_APPLICATION_FAILURE
  REVERIFICATION_FAILED
  REGRESSION_DETECTED
  APPROVAL_REJECTED
  PATCH_FAILED
  NO_FIX_NEEDED
  EXECUTION_FAILED
  CANCELLED
}

model AgentAutonomousWorkflowReport {
  id                    String                         @id @default(uuid()) @db.Uuid
  projectId             String                         @map("project_id") @db.Uuid
  threadId              String                         @map("thread_id") @db.Uuid
  taskId                String                         @unique @map("task_id") @db.Uuid
  userId                String                         @map("user_id") @db.Uuid
  workflowStatus        AutonomousWorkflowStatus       @default(PLANNING) @map("workflow_status")
  finalStatus           AutonomousWorkflowFinalStatus? @map("final_status")
  releaseReady          Boolean                        @default(false) @map("release_ready")
  originalRequest       String                         @map("original_request") @db.Text
  planSummary           String?                        @map("plan_summary") @db.Text
  testsExecuted         Json                           @default("[]") @map("tests_executed")
  requirementsCovered   Json                           @default("[]") @map("requirements_covered")
  failuresFound         Json                           @default("[]") @map("failures_found")
  evidenceReferences    Json                           @default("{}") @map("evidence_references")
  failureClassification Json?                          @map("failure_classification")
  rootCauseAnalysis     Json?                          @map("root_cause_analysis")
  proposedPatch         Json?                          @map("proposed_patch")
  approvalDecision      Json?                          @map("approval_decision")
  beforeAfterResults    Json?                          @map("before_after_results")
  regressionResults     Json?                          @map("regression_results")
  unresolvedIssues      Json                           @default("[]") @map("unresolved_issues")
  auditTrail            Json                           @default("[]") @map("audit_trail")
  createdAt             DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  thread  AgentThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  task    AgentThreadTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, workflowStatus])
  @@index([taskId])
  @@index([threadId])
  @@index([userId])
  @@index([createdAt])
  @@map("agent_autonomous_workflow_reports")
}

